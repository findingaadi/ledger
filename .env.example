# Copy to .env and fill in. .env is gitignored; never commit real values.

# Safe to ship in the app (public by design)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. These are set as Supabase function secrets, never bundled into the app.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Comma-separated URL prefixes the login may redirect back to
APP_RETURN_PREFIXES=ledger://,exp://,http://localhost:8081
